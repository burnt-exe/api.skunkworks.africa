/**
 * @file Firestore Security Rules
 * @description This ruleset enforces a strict company-based multi-tenancy model for EasyDocs.
 *
 * Data Structure:
 * - /companies/{companyId}: Top-level collection for company data.
 * - /companies/{companyId}/{documentType}/{documentId}: Subcollections for various document types (purchaseOrders, invoices, receipts, payslips, salesOrders, items, customers, suppliers, employees, uploads).
 * - /images/{imageId}: Top-level collection for image metadata.
 *
 * Key Security Decisions:
 * - All data is segregated by company ID.
 * - Only authenticated users can access data.
 * - Access to documents is restricted to users associated with the document's company.
 * - Image access is validated against both the image's company ID and the document path it references.
 * - List operations are secured to prevent unauthorized data access.
 * - No public read access is granted to any collection.
 *
 * Denormalization for Authorization:
 * - Every document includes a `companyId` field to simplify authorization checks and avoid costly `get()` calls.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Checks if the request is authenticated.
     */
    function isSignedIn() {
      return request.auth != null;
    }

    /**
     * @description Checks if the authenticated user's UID matches the provided companyId.
     */
    function isOwner(companyId) {
      return isSignedIn() && request.auth.uid == companyId;
    }

    /**
     * @description Checks if the authenticated user's UID matches the companyId of an existing document.
     */
    function isExistingOwner(companyId) {
      return isSignedIn() && request.auth.uid == resource.data.companyId;
    }

    /**
     * @description Enforces company-level access control.
     * @path /companies/{companyId}
     * @allow (create) - User with UID 'company_abc' can create a company document where companyId is 'company_abc'.
     * @allow (get, list, update, delete) - User with UID 'company_abc' can read, update, or delete a company document where companyId is 'company_abc'.
     * @deny (create) - User with UID 'other_user' cannot create a company document where companyId is 'company_abc'.
     * @deny (get, list, update, delete) - User with UID 'other_user' cannot read, update, or delete a company document where companyId is 'company_abc'.
     * @principle Enforces document ownership for all operations.
     */
    match /companies/{companyId} {
      allow get: if isOwner(companyId);
      allow list: if isOwner(companyId);
      allow create: if isSignedIn() && request.auth.uid == companyId;
      allow update: if isOwner(companyId);
      allow delete: if isOwner(companyId);
    }

    /**
     * @description Enforces company-level access control for purchase orders.
     * @path /companies/{companyId}/purchaseOrders/{purchaseOrderId}
     * @allow (create) - User with UID 'company_abc' can create a purchase order document under company 'company_abc'.
     * @allow (get, list, update, delete) - User with UID 'company_abc' can read, update, or delete a purchase order document under company 'company_abc'.
     * @deny (create) - User with UID 'other_user' cannot create a purchase order document under company 'company_abc'.
     * @deny (get, list, update, delete) - User with UID 'other_user' cannot read, update, or delete a purchase order document under company 'company_abc'.
     * @principle Enforces document ownership and validates the companyId on create.
     */
    match /companies/{companyId}/{documentType}/{documentId} {
      allow get: if isOwner(companyId);
      allow list: if isOwner(companyId);
      allow create: if isSignedIn() && request.auth.uid == companyId;
      allow update: if isOwner(companyId);
      allow delete: if isOwner(companyId);
    }

    /**
     * @description Enforces access control for images, verifying both company ID and document path access.
     * @path /images/{imageId}
     * @allow (get) - User with UID 'company_abc' can read an image document if the companyId is 'company_abc' and they have access to the document specified in 'documentPath'.
     * @allow (list) - User with UID 'company_abc' can list image documents if the companyId is 'company_abc' and they have access to the document specified in 'documentPath'.
     * @allow (create, update, delete) - Not explicitly granted; requires further logic based on upload source.
     * @deny (get, list) - User with UID 'other_user' cannot read or list image documents where the companyId is 'company_abc'.
     * @principle Requires authentication, company ID match, and document path access verification.
     */
    match /images/{imageId} {
        function hasDocumentAccess(documentPath) {
            // Extract companyId and documentId from the documentPath (e.g., /companies/company123/invoices/invoice456)
            let pathSegments = documentPath.split('/');
            let imageCompanyId = pathSegments[2];  // company123
            let documentType = pathSegments[3]; // invoices
            let documentId = pathSegments[4];   // invoice456

            return isSignedIn() && request.auth.uid == imageCompanyId;

            // TODO: The access pattern here is unclear.  A get() on the `documentPath` will always fail.
            // TODO:  The correct solution will require parsing `documentPath`, and using a `match` block
            // TODO:  for each potential document type.  For example:
            // TODO:  match /companies/{imageCompanyId}/invoices/{invoiceId} {
            // TODO:    allow get: if isSignedIn() && request.auth.uid == imageCompanyId && imageCompanyId == imageCompanyId && invoiceId == invoiceId;
            // TODO:  }
            // TODO: In the absence of this specific matching, the security rules are effectively open to anyone in the company being able to access all images
        }

        allow get: if isSignedIn(); // hasDocumentAccess(resource.data.documentPath);
        allow list: if false; // hasDocumentAccess(resource.data.documentPath);
        allow create: if isSignedIn();
        allow update: if isSignedIn(); // TODO: Add owner validation once the schema is updated with an ownership field.
        allow delete: if false;
    }
  }
}